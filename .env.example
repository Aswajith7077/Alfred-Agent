# Copy to .env and fill in before running `docker compose up`.

# Obsidian vault to mount into the backend container (bind-mounted at /app/vault).
VAULT_PATH=./obsidian-vault

# Gmail-connected accounts (see backend/apps/config/settings.py).
EMAIL_ADDRESS_I=
EMAIL_ADDRESS_II=
EMAIL_APP_PASSWORD_I=
EMAIL_APP_PASSWORD_II=

# Required for pyannote-audio speaker diarization models.
HUGGING_FACE_TOKEN=
